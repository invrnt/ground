{
  "name": "@ground/channel-slack",
  "version": "0.1.0",
  "private": true,
  "description": "Slack channel adapter for Ground. Turns Slack messages, files and button taps into the shared channel contract and renders Ground cards as Block Kit.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@slack/bolt": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
