# Slack app credentials (create the app from slack-manifest.json, then copy from api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...            # App-level token with connections:write (Socket Mode)

# Authorization. Only these conversations are read; only these may receive outbound messages.
SLACK_ALLOWED_CHANNELS=C0123456789,C0987654321   # site group, supervisor private channel
SLACK_SUPPLIER_CHANNEL=C0555555555                # test supplier conversation (outbound only)
SLACK_ALLOWED_USERS=                              # optional, comma-separated user ids. Empty = any member of an allowed channel

# Core ingress. Leave CORE_URL empty to run against the built-in fake core for local testing.
CORE_URL=
CORE_CHANNEL_SECRET=change-me

# Limits (PRD internal limits)
MAX_ATTACHMENT_MB=10
MAX_AUDIO_SECONDS=60

LOG_LEVEL=info
