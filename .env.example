# Copy to .env locally. Never commit configured values.
DATABASE_URL=postgres://ground:ground-local-only@localhost:5432/ground
POSTGRES_PASSWORD=ground-local-only
PORT=3000
HOST=127.0.0.1
PRIVATE_STORAGE_PATH=.storage/private
PUBLIC_BASE_URL=
SESSION_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEMO_CHAT_ID=
TELEGRAM_DEMO_RECIPIENT_ID=
OPENROUTER_API_KEY=
OPENROUTER_TRANSCRIPTION_MODEL=
OPENROUTER_INTERPRETATION_MODEL=
EXA_API_KEY=
AMBIGUOUS_API_TOKEN=
AMBIGUOUS_BASE_URL=
AMBIGUOUS_WORKSPACE_ID=
AMBIGUOUS_JUAN_USER_ID=
COPILOTKIT_PUBLIC_API_KEY=
# Provisioning only. Use unique passwords of at least 12 characters; never commit them.
DEMO_MANIFEST_PATH=
DEMO_PASSWORD_ADMIN=
DEMO_PASSWORD_LUIS=
DEMO_PASSWORD_ANA=
DEMO_PASSWORD_JUAN=
DEMO_PASSWORD_PURCHASING=
# Optional system ffmpeg binary for bounded audio conversion.
FFMPEG_PATH=ffmpeg
# Exact deployed Git commit for run evidence exports.
CODE_VERSION=
# Provisioned admin identity used by local operator CLI commands.
DEMO_ADMIN_USERNAME=admin
